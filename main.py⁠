# 2. Venice Client Integration (Venice.ai API Setup)
VENICE_BASE_URL = os.environ.get("VENICE_BASE_URL", "https://api.venice.ai/api/v1")
VENICE_API_KEY = os.environ.get("VENICE_API_KEY", "")

class VeniceAdvancedClient:
    def __init__(self, api_key: str = None):
        self.api_key = api_key or VENICE_API_KEY
        self.base_url = VENICE_BASE_URL.rstrip("/")
        self.session = requests.Session()
        self.update_headers()

    def update_headers(self, key: str = None):
        if key:
            self.api_key = key
        if self.api_key:
            self.session.headers.update({
                "Authorization": f"Bearer {self.api_key}",
                "User-Agent": "jarvis-venice-client/2.0",
                "Content-Type": "application/json"
            })

    def chat_completion(self, prompt: str, model: str = "venice-uncensored", system: str = None) -> str:
        if not self.api_key:
            return "⚠️ API Key നൽകിയിട്ടില്ല! '⚙️ API Config' ടാബിൽ പോയി നിങ്ങളുടെ Venice API Key നൽകുക."

        messages = []
        if system:
            messages.append({"role": "system", "content": system})
        messages.append({"role": "user", "content": prompt})

        body = {
            "model": model,
            "messages": messages,
            "temperature": 0.7
        }
        
        try:
            resp = self.session.post(f"{self.base_url}/chat/completions", json=body, timeout=60)
            if resp.status_code == 200:
                data = resp.json()
                return data["choices"][0]["message"]["content"]
            else:
                return f"Venice API Error (HTTP {resp.status_code}): {resp.text}"
        except Exception as e:
            return f"Connection Failed: {str(e)}"

    def generate_image(self, prompt: str, model: str = "flux-dev") -> str:
        if not self.api_key:
            return ""

        body = {"model": model, "prompt": prompt, "format": "png"}
        try:
            resp = self.session.post(f"{self.base_url}/image/generate", json=body, timeout=60)
            if resp.status_code == 200:
                data = resp.json()
                images = data.get("images", [])
                if images:
                    return images[0]
            return ""
        except Exception as e:
            return ""

