@app.route("/api/chat", methods=["POST"])
def api_chat():
    data = request.get_json() or {}
    message = data.get("message", "")
    reply = client.chat_completion(message, system="Your name is JARVIS. You are an advanced AI assistant.")
    return jsonify({"reply": reply})

@app.route("/api/image", methods=["POST"])
def api_image():
    data = request.get_json() or {}
    prompt = data.get("prompt", "")
    img_data = client.generate_image(prompt)
    return jsonify({"image": img_data})

@app.route("/api/set-key", methods=["POST"])
def set_key():
    data = request.get_json() or {}
    key = data.get("key", "")
    client.update_headers(key)
    return jsonify({"status": "API Key വിജയകരമായി സെറ്റ് ചെയ്തു!"})

